# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.

region       = "eu-paris-1"
tenancy_ocid = "ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# A dedicated compartment named `compartment_name` is created by Terraform (see compartment.tf).

ssh_public_key_path = "~/.ssh/id_rsa.pub"
ssh_allowed_cidr    = "0.0.0.0/0" # narrow this to your own IP/32

# Leave empty to use the default Oracle Linux 9 platform image (see image.tf),
# or set a specific image OCID to override it.
image_id = ""
